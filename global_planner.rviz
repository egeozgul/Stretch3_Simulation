Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Class: rviz_default_plugins/Grid
      Cell Size: 0.5
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.75
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Static Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.35
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          stretch/odom:
            stretch/base_link:
              stretch/laser:
                {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 118; 210
      Enabled: true
      Head Diameter: 0.15
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.08
      Name: Global Path
      Offset:
        X: 0
        Y: 0
        Z: 0.03
      Pose Color: 255; 171; 64
      Pose Style: Arrows
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.15
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stretch/global_path
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Odometry
      Color: 255; 64; 129
      Enabled: true
      Keep: 30
      Name: Robot Odom
      Position Tolerance: 0.1
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stretch/odom
      Value: true
    - Alpha: 0.8
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Class: rviz_default_plugins/LaserScan
      Color: 0; 200; 83
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Stretch1 Scan Obstacles
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stretch/scan
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.65
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Local Costmap Obstacles
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stretch/local_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stretch/local_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Marker Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stretch/global_path_marker
      Name: Global Path Marker
      Namespaces:
        stretch_global_path: true
      Queue Size: 10
      Value: false
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Marker Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stretch/global_endpoint_markers
      Name: Start And Target Markers
      Namespaces:
        stretch_global_path_endpoints: true
      Queue Size: 10
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stretch/global_plan_markers
      Name: Global Plan Markers
      Namespaces:
        stretch_global_path: true
        stretch_global_path_endpoints: true
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stretch/anchor_markers
      Name: Anchor Markers
      Namespaces:
        stretch_anchor_labels: true
        stretch_anchors: true
      Queue Size: 10
      Value: true
    - Alpha: 1
      Axes Length: 0.25
      Axes Radius: 0.04
      Class: rviz_default_plugins/PoseArray
      Color: 0; 170; 255
      Enabled: true
      Head Length: 0.12
      Head Radius: 0.06
      Name: Anchor Poses
      Shaft Length: 0.18
      Shaft Radius: 0.03
      Shape: Arrow
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stretch/anchor_poses
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 255
      Enabled: true
      Head Diameter: 0.12
      Head Length: 0.16
      Length: 0.2
      Line Style: Lines
      Line Width: 0.05
      Name: Anchor Path Debug
      Offset:
        X: 0
        Y: 0
        Z: 0.04
      Pose Color: 0; 255; 255
      Pose Style: Arrows
      Radius: 0.03
      Shaft Diameter: 0.04
      Shaft Length: 0.12
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stretch/anchor_path_debug
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 24; 27
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic: /clicked_point
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 0
        Y: 1.8
        Z: 0
      Name: Current View
      Pitch: 1.5708
      Target Frame: map
      Yaw: 1.5708
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  X: 80
  Y: 60
